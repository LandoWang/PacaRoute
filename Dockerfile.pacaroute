FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /pacaroute ./cmd/pacaroute

FROM alpine:3.22
RUN apk add --no-cache ca-certificates && addgroup -g 10001 pacaroute && adduser -D -u 10001 -G pacaroute pacaroute && mkdir /data && chown pacaroute:pacaroute /data
COPY --from=build /pacaroute /usr/local/bin/pacaroute
COPY THIRD_PARTY_NOTICES.md /usr/share/doc/pacaroute/THIRD_PARTY_NOTICES.md
USER pacaroute
ENV PACAROUTE_HOME=/data
VOLUME /data
EXPOSE 8766
ENTRYPOINT ["pacaroute"]
CMD ["serve", "--bind", "0.0.0.0", "--port", "8766"]
